# ─── PostgreSQL / PostGIS (shared with backend) ──────────────────────────────
DATABASE_URL=postgresql://climatex_user:climatex_pass@127.0.0.1:5433/climatex

# ─── FastAPI App ──────────────────────────────────────────────────────────────
APP_ENV=development
ML_SERVICE_PORT=8001

# ─── CORS / Backend ───────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─── Storage paths (must match backend .env) ─────────────────────────────────
# Path to Phase 5A processed rasters (shared with backend)
EO_STORAGE_PATH=../backend/eo_data

# Where to write change-map GeoTIFFs
ML_STORAGE_PATH=../backend/eo_data/change_maps

# ─── Algorithm Parameters ────────────────────────────────────────────────────
# k_sigma: threshold multiplier for μ ± k·σ change detection
K_SIGMA=1.5
# Minimum connected-component size (pixels) to suppress speckle noise
MIN_CHANGE_AREA_PX=9
