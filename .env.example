# ─── PostgreSQL / PostGIS ────────────────────────────────────────────────────
POSTGRES_DB=climatex
POSTGRES_USER=climatex_user
POSTGRES_PASSWORD=climatex_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ─── SQLAlchemy ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://climatex_user:climatex_pass@localhost:5432/climatex

# ─── FastAPI App ─────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-use-a-long-random-string
BACKEND_PORT=8000

# ─── CORS / Frontend ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Phase 4: Earth Observation Satellite Data Providers (Optional) ──────────
# Copernicus Data Space (Sentinel-1, Sentinel-2)
# Search is public (no credentials required). Download requires OAuth2 client credentials.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# USGS Machine-to-Machine API (Landsat 8/9)
# Register free at https://ers.cr.usgs.gov
USGS_USERNAME=
USGS_PASSWORD=

# UP42 Multi-Source Commercial Catalog
UP42_PROJECT_ID=
UP42_PROJECT_API_KEY=

# EO Storage & File Constraints
EO_STORAGE_PATH=./eo_data
MAX_SCENE_FILE_SIZE_MB=500

# ─── Next.js Public Environment Variables ────────────────────────────────────
# Used by the frontend to construct direct API calls (client-side)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
